---
import type { TrackSelector } from "../../data/track-selectors";
import type { QuizQuestion } from "../../quiz/types/quiz-types";
import { questionTypeLabel } from "../../quiz/session/labels";
import { blueprintTopics } from "../../data/blueprint-topics";

interface Props {
    track: TrackSelector;
}

const { track } = Astro.props;
const topics = blueprintTopics[track.slug] ?? [];
const topicTitlesJson = JSON.stringify(
    Object.fromEntries(topics.map((topic) => [topic.id, topic.title])),
).replace(/</g, "\\u003c");
const questionTypes: QuizQuestion["question_type"][] = [
    "mcq-single",
    "mcq-multi",
    "multi-tf",
    "matching",
    "drag-order",
    "fill-blank",
];
---

<div class="top-bar">
    <div class="breadcrumb">
        netlabs <span class="chev">/</span>
        <b>{track.statusLabel}</b>
        <span class="chev">/</span>
        question bank
        <span class="chev">/</span>
        <b>browse</b>
    </div>
    <div class="right">
        <span><span class="kbd">/</span> search</span>
        <span><span class="kbd">↑</span><span class="kbd">↓</span> move</span>
    </div>
</div>

<div class="editor-body inner-page bank-page" data-bank-page data-track-slug={track.slug}>
    <script
        type="application/json"
        data-bank-topics
        set:html={topicTitlesJson}
    />
    <section class="inner-hero">
        <div>
            <h1>Question bank<span>/all</span></h1>
            <p>Every question in the bank, one row each.</p>
        </div>
    </section>

    <div class="bank-controls">
        <div class="chip-row" data-bank-domains>
            <button class="chip-f on" data-domain="all" aria-pressed="true">
                all domains
            </button>
            {
                track.domains.map((domain) => (
                    <button
                        class="chip-f"
                        data-domain={domain.number}
                        title={domain.name}
                        aria-pressed="false"
                    >
                        {domain.number} {domain.short}
                        <span class="c" />
                    </button>
                ))
            }
        </div>
        <div class="bank-toolbar">
            <span class="count" aria-hidden="true">
                showing <b data-bank-shown>0</b> of <b data-bank-count>0</b> items
            </span>
            <span class="visually-hidden" role="status" data-bank-status></span>
            <span class="bank-spacer"></span>
            <label class="selecta">
                sort
                <select data-bank-filter="sort">
                    <option value="id">catalog #</option>
                    <option value="domain">domain</option>
                    <option value="type">type</option>
                    <option value="stem">a → z</option>
                </select>
            </label>
            <label class="selecta">
                type
                <select data-bank-filter="type">
                    <option value="all">all</option>
                    {
                        questionTypes.map((type) => (
                            <option value={type}>{questionTypeLabel(type)}</option>
                        ))
                    }
                </select>
            </label>
            <span class="bank-search">
                <input
                    type="search"
                    data-bank-search
                    placeholder="search items..."
                    aria-label="Search questions"
                    autocomplete="off"
                    spellcheck="false"
                />
                <span class="kbd">/</span>
            </span>
            <button
                class="bank-random"
                type="button"
                aria-label="Pick one"
                data-bank-random
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.8-1.1 2-1.7 3.3-1.7H22" />
                    <path d="m18 2 4 4-4 4" />
                    <path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2" />
                    <path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8" />
                    <path d="m18 14 4 4-4 4" />
                </svg>
            </button>
        </div>
    </div>

    <div class="qtable">
        <div class="qhead">
            <span class="qnum">#</span>
            <span class="qstem">question</span>
            <span class="qdom">domain</span>
            <span class="qtopic">topic</span>
            <span class="qtype">type</span>
        </div>
        <div class="qbody" data-bank-list>
            <span class="drill-state">loading questions...</span>
        </div>
        <div class="bank-sentinel" data-bank-sentinel></div>
    </div>
</div>

<script>
    import { fetchBankQuestions } from "../../data/bank-client";
    import { questionTypeShort } from "../../quiz/session/labels";
    import {
        buildSearchIndex,
        domainCounts,
        filterQuestions,
        sortQuestions,
        type BankFilters,
        type BankSort,
    } from "./bank-list";
    import type { BankQuestion } from "../../data/bank-types";

    const CHUNK = 100;

    const page = document.querySelector<HTMLElement>("[data-bank-page]")!;
    const list = document.querySelector<HTMLElement>("[data-bank-list]")!;
    const sentinel = document.querySelector<HTMLElement>(
        "[data-bank-sentinel]",
    )!;
    const shownEl = document.querySelector<HTMLElement>("[data-bank-shown]")!;
    const countEl = document.querySelector<HTMLElement>("[data-bank-count]")!;
    const chipRow = document.querySelector<HTMLElement>(
        "[data-bank-domains]",
    )!;
    const typeSelect = document.querySelector<HTMLSelectElement>(
        '[data-bank-filter="type"]',
    )!;
    const sortSelect = document.querySelector<HTMLSelectElement>(
        '[data-bank-filter="sort"]',
    )!;
    const searchInput =
        document.querySelector<HTMLInputElement>("[data-bank-search]")!;
    const statusEl = document.querySelector<HTMLElement>("[data-bank-status]")!;
    const randomButton = document.querySelector<HTMLButtonElement>(
        "[data-bank-random]",
    )!;

    const topicTitles = new Map<string, string>(
        Object.entries(
            JSON.parse(
                document.querySelector("[data-bank-topics]")?.textContent ??
                    "{}",
            ) as Record<string, string>,
        ),
    );

    let loaded = false;
    let questions: BankQuestion[] = [];
    let sorted: BankQuestion[] = [];
    let visible: BankQuestion[] = [];
    let searchIndex: ReadonlyMap<string, string> = new Map();
    let rendered = 0;
    let selectedRow: HTMLElement | null = null;

    function rowIndex(row: Element | null): number {
        return row ? Array.prototype.indexOf.call(list.children, row) : -1;
    }
    const filters: BankFilters = {
        domain: "all",
        type: "all",
        query: "",
    };

    function practiceHref(question: BankQuestion): string {
        return `/quiz?question=${encodeURIComponent(question.id)}`;
    }

    function buildRow(question: BankQuestion): HTMLAnchorElement {
        const row = document.createElement("a");
        row.className = "qrow";
        row.href = practiceHref(question);
        row.tabIndex = -1;
        const cells: [string, string][] = [
            ["qnum", question.id],
            ["qstem", question.stem],
            ["qdom", question.topic_id],
            ["qtopic", question.sub_topic_id],
            ["qtype", questionTypeShort(question.question_type)],
        ];
        for (const [className, text] of cells) {
            const cell = document.createElement("span");
            cell.className = className;
            cell.textContent = text;
            row.append(cell);
        }
        return row;
    }

    function renderMore() {
        const next = visible.slice(rendered, rendered + CHUNK);
        list.append(...next.map((question) => buildRow(question)));
        rendered += next.length;
    }

    function fillViewport() {
        const viewportBottom =
            window.innerHeight || document.documentElement.clientHeight;
        while (
            rendered < visible.length &&
            sentinel.getBoundingClientRect().top <= viewportBottom
        ) {
            renderMore();
        }
    }

    function showState(text: string, isError = false) {
        const span = document.createElement("span");
        span.className = isError ? "drill-state error" : "drill-state";
        span.textContent = text;
        list.replaceChildren(span);
    }

    function updateCounts(countsBase: readonly BankQuestion[]) {
        shownEl.textContent = String(visible.length);
        countEl.textContent = String(questions.length);
        const counts = domainCounts(countsBase);
        for (const chip of chipRow.querySelectorAll<HTMLElement>(".chip-f")) {
            const badge = chip.querySelector(".c");
            if (!badge || !chip.dataset.domain) continue;
            badge.textContent = String(counts.get(chip.dataset.domain) ?? 0);
        }
    }

    function resort() {
        sorted = sortQuestions(questions, sortSelect.value as BankSort);
    }

    let statusTimer = 0;
    function announceCount() {
        window.clearTimeout(statusTimer);
        statusTimer = window.setTimeout(() => {
            statusEl.textContent =
                visible.length === 0
                    ? "no matching questions"
                    : `${visible.length} results`;
        }, 500);
    }

    function refresh() {
        if (!loaded) return;
        const hadListFocus =
            document.activeElement !== null &&
            list.contains(document.activeElement);
        const previousIndex = rowIndex(selectedRow);
        const countsBase = filterQuestions(
            sorted,
            { ...filters, domain: "all" },
            searchIndex,
        );
        visible = countsBase.filter(
            (question) =>
                filters.domain === "all" ||
                question.topic_id === filters.domain,
        );
        rendered = 0;
        selectedRow = null;
        list.replaceChildren();
        if (visible.length === 0) {
            showState("no matching questions");
            if (hadListFocus) searchInput.focus();
        } else {
            renderMore();
            fillViewport();
            if (hadListFocus) {
                select(Math.max(previousIndex, 0));
            } else {
                (list.children[0] as HTMLElement).tabIndex = 0;
            }
        }
        updateCounts(countsBase);
        announceCount();
    }

    function select(index: number) {
        if (visible.length === 0) return;
        const clamped = Math.min(Math.max(index, 0), visible.length - 1);
        while (rendered <= clamped) renderMore();
        if (selectedRow) selectedRow.tabIndex = -1;
        (list.children[0] as HTMLElement).tabIndex = -1;
        selectedRow = list.children[clamped] as HTMLElement;
        selectedRow.tabIndex = 0;
        selectedRow.focus({ preventScroll: true });
        selectedRow.scrollIntoView({ block: "nearest" });
    }

    function pickRandom() {
        if (visible.length === 0) return;
        const question = visible[Math.floor(Math.random() * visible.length)];
        window.location.href = practiceHref(question);
    }

    chipRow.addEventListener("click", (event) => {
        const chip = (event.target as HTMLElement).closest<HTMLElement>(
            ".chip-f",
        );
        if (!chip) return;
        filters.domain = chip.dataset.domain ?? "all";
        for (const other of chipRow.querySelectorAll(".chip-f")) {
            other.classList.toggle("on", other === chip);
            other.setAttribute("aria-pressed", String(other === chip));
        }
        refresh();
    });

    typeSelect.addEventListener("change", () => {
        filters.type = typeSelect.value;
        refresh();
    });
    sortSelect.addEventListener("change", () => {
        resort();
        refresh();
    });

    let searchFrame = 0;
    searchInput.addEventListener("input", () => {
        filters.query = searchInput.value;
        cancelAnimationFrame(searchFrame);
        searchFrame = requestAnimationFrame(refresh);
    });

    randomButton.addEventListener("click", pickRandom);

    list.addEventListener("keydown", (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        const target =
            event.target instanceof HTMLElement ? event.target : null;
        const focusedRow = target?.closest(".qrow");
        if (!focusedRow) return;
        const index = rowIndex(focusedRow);
        if (event.key === "ArrowDown") {
            event.preventDefault();
            select(index + 1);
        } else if (event.key === "ArrowUp") {
            event.preventDefault();
            if (index <= 0) searchInput.focus();
            else select(index - 1);
        } else if (event.key === "Home") {
            event.preventDefault();
            select(0);
        } else if (event.key === "End") {
            event.preventDefault();
            select(visible.length - 1);
        } else if (event.key === "/") {
            event.preventDefault();
            searchInput.focus();
        } else if (event.key.toLowerCase() === "r") {
            pickRandom();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.isComposing || event.keyCode === 229) return;
        const target =
            event.target instanceof HTMLElement ? event.target : null;
        if (target && list.contains(target)) return;
        if (target === searchInput) {
            if (event.key === "Escape") {
                searchInput.blur();
            } else if (event.key === "ArrowDown") {
                event.preventDefault();
                select(Math.max(rowIndex(selectedRow), 0));
            }
            return;
        }
        if (
            target?.matches(
                "input, textarea, select, [contenteditable='true']",
            )
        ) {
            return;
        }
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        if (event.key === "/") {
            event.preventDefault();
            searchInput.focus();
        }
    });

    new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
            fillViewport();
        }
    }).observe(sentinel);

    fetchBankQuestions(page.dataset.trackSlug!)
        .then((data) => {
            questions = data.questions;
            searchIndex = buildSearchIndex(questions, topicTitles);
            loaded = true;
            resort();
            refresh();
        })
        .catch(() => {
            showState("questions unavailable", true);
            statusEl.textContent = "questions unavailable";
        });
</script>
