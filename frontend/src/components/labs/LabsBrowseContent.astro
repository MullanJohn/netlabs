---
import type { CollectionEntry } from "astro:content";
import ShortcutHelp from "../shell/ShortcutHelp.astro";
import { examLabel, LAB_EXAMS, type LabVendor } from "../../labs/taxonomy";

interface Props {
    vendor: LabVendor;
    labs: CollectionEntry<"labs">[];
}

const { vendor, labs } = Astro.props;

const difficulties = ["Foundation", "Advanced", "Expert"];
const examIds = LAB_EXAMS.filter((exam) =>
    labs.some((lab) => lab.data.exams.includes(exam.id)),
).map((exam) => exam.id);

function shortTime(estTime: string): string {
    return estTime ? estTime.replace(/\s*minutes?\b/i, "m") : "—";
}

function searchText(lab: CollectionEntry<"labs">): string {
    const { data } = lab;
    return [
        data.title,
        data.labCode,
        data.topic,
        data.slug,
        ...data.exams.map((exam) => examLabel(exam)),
    ]
        .join(" ")
        .toLowerCase();
}
---

<div class="top-bar">
    <div class="breadcrumb">
        netlabs <span class="chev">/</span>
        <a href="/labs/">labs</a>
        <span class="chev">/</span>
        <b>{vendor}</b>
    </div>
</div>

<div class="editor-body inner-page labs-page page-col">
    <section class="inner-hero">
        <div>
            <h1>Labs<span>/{vendor}</span></h1>
            <div class="labs-guides">
                before you start:
                <a href={`/labs/${vendor}/setup/`}>{vendor} setup guide</a>
            </div>
        </div>
    </section>

    <div class="bank-controls">
        <div class="chip-row" data-labs-difficulties>
            <button class="chip-f on" data-difficulty="all" aria-pressed="true">
                all difficulties
            </button>
            {
                difficulties.map((difficulty) => (
                    <button
                        class="chip-f"
                        data-difficulty={difficulty.toLowerCase()}
                        aria-pressed="false"
                    >
                        {difficulty.toLowerCase()}
                        <span class="c" />
                    </button>
                ))
            }
        </div>
        <div class="bank-toolbar">
            <span class="count" aria-hidden="true">
                showing <b data-labs-shown>0</b> of <b data-labs-count>0</b> labs
            </span>
            <span class="visually-hidden" role="status" data-labs-status></span>
            <span class="bank-spacer"></span>
            <label class="selecta">
                exam
                <select data-labs-filter="exam">
                    <option value="all">all</option>
                    {
                        examIds.map((exam) => (
                            <option value={exam}>{examLabel(exam)}</option>
                        ))
                    }
                </select>
            </label>
            <span class="bank-search">
                <input
                    type="search"
                    data-labs-search
                    placeholder="search titles, topics, ids..."
                    aria-label="Search labs"
                    autocomplete="off"
                    spellcheck="false"
                />
                <span class="kbd" data-labs-slash>/</span>
                <button
                    class="bank-clear"
                    type="button"
                    aria-label="Clear search"
                    data-labs-clear
                    hidden
                >
                    <span aria-hidden="true">✕</span>
                </button>
            </span>
            <button
                class="bank-random"
                type="button"
                aria-label="Pick one"
                data-labs-random
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.8-1.1 2-1.7 3.3-1.7H22" />
                    <path d="m18 2 4 4-4 4" />
                    <path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2" />
                    <path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8" />
                    <path d="m18 14 4 4-4 4" />
                </svg>
            </button>
            <button
                class="bank-help"
                type="button"
                aria-label="Keyboard shortcuts"
                data-kbd-open>?</button
            >
        </div>
    </div>

    <div class="qtable">
        <div class="lhead">
            <span class="lnum">
                <button type="button" class="qsort" data-labs-sort="id" data-dir="asc">
                    <span class="visually-hidden">sort by catalog </span>#<span
                        class="qsort-arrow"
                        aria-hidden="true"
                        data-labs-arrow>▲</span
                    ><span class="visually-hidden" data-labs-note>, sorted ascending</span>
                </button>
            </span>
            <span class="lname">
                <button type="button" class="qsort" data-labs-sort="title">
                    <span class="visually-hidden">sort by </span>lab<span
                        class="qsort-arrow"
                        aria-hidden="true"
                        data-labs-arrow>↕</span
                    ><span class="visually-hidden" data-labs-note></span>
                </button>
            </span>
            <span class="ldiff">
                <button type="button" class="qsort" data-labs-sort="difficulty">
                    <span class="visually-hidden">sort by </span>difficulty<span
                        class="qsort-arrow"
                        aria-hidden="true"
                        data-labs-arrow>↕</span
                    ><span class="visually-hidden" data-labs-note></span>
                </button>
            </span>
            <span class="ltime">
                <button type="button" class="qsort" data-labs-sort="time">
                    <span class="visually-hidden">sort by </span>time<span
                        class="qsort-arrow"
                        aria-hidden="true"
                        data-labs-arrow>↕</span
                    ><span class="visually-hidden" data-labs-note></span>
                </button>
            </span>
        </div>
        <div class="qbody" data-labs-list>
            {
                labs.map((lab) => (
                    <a
                        class="lrow"
                        href={`/labs/${lab.id}/`}
                        data-number={lab.data.number}
                        data-difficulty={lab.data.difficulty.toLowerCase()}
                        data-exams={lab.data.exams.join(" ")}
                        data-minutes={lab.data.estMinutes}
                        data-title={lab.data.title.toLowerCase()}
                        data-search={searchText(lab)}
                    >
                        <span class="lnum">
                            {String(lab.data.number).padStart(3, "0")}
                        </span>
                        <span class="lname">
                            <span class="t">{lab.data.title}</span>
                            <small>{lab.data.labCode}</small>
                        </span>
                        <span class="ldiff">
                            <i
                                class={`lab-badge ${lab.data.difficulty.toLowerCase()}`}
                            >
                                {lab.data.difficulty.toLowerCase()}
                            </i>
                        </span>
                        <span class="ltime">{shortTime(lab.data.estTime)}</span>
                    </a>
                ))
            }
        </div>
    </div>
</div>

<ShortcutHelp />

<script>
    import { matchRanges, tokenize } from "../bank/bank-list";

    const list = document.querySelector<HTMLElement>("[data-labs-list]")!;
    const shownEl = document.querySelector<HTMLElement>("[data-labs-shown]")!;
    const countEl = document.querySelector<HTMLElement>("[data-labs-count]")!;
    const chipRow = document.querySelector<HTMLElement>(
        "[data-labs-difficulties]",
    )!;
    const examSelect = document.querySelector<HTMLSelectElement>(
        '[data-labs-filter="exam"]',
    )!;
    const sortButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-labs-sort]"),
    );
    const searchInput =
        document.querySelector<HTMLInputElement>("[data-labs-search]")!;
    const statusEl = document.querySelector<HTMLElement>("[data-labs-status]")!;
    const randomButton = document.querySelector<HTMLButtonElement>(
        "[data-labs-random]",
    )!;
    const clearButton = document.querySelector<HTMLButtonElement>(
        "[data-labs-clear]",
    )!;
    const slashHint = document.querySelector<HTMLElement>("[data-labs-slash]")!;

    interface LabRow {
        el: HTMLAnchorElement;
        number: number;
        difficulty: string;
        exams: string[];
        minutes: number;
        title: string;
        search: string;
        titleEl: HTMLElement;
        codeEl: HTMLElement;
        titleText: string;
        codeText: string;
    }

    const rows: LabRow[] = Array.from(
        list.querySelectorAll<HTMLAnchorElement>(".lrow"),
    ).map((el) => {
        const titleEl = el.querySelector<HTMLElement>(".lname .t")!;
        const codeEl = el.querySelector<HTMLElement>(".lname small")!;
        return {
            el,
            number: Number(el.dataset.number),
            difficulty: el.dataset.difficulty!,
            exams: el.dataset.exams!.split(" ").filter(Boolean),
            minutes: Number(el.dataset.minutes),
            title: el.dataset.title!,
            search: el.dataset.search!,
            titleEl,
            codeEl,
            titleText: titleEl.textContent!.trim(),
            codeText: codeEl.textContent!.trim(),
        };
    });

    const DIFFICULTY_RANK: Record<string, number> = {
        foundation: 0,
        advanced: 1,
        expert: 2,
    };
    const DIFFICULTIES = new Set(Object.keys(DIFFICULTY_RANK));

    const SORT_KEYS = ["id", "title", "difficulty", "time"] as const;
    type SortKey = (typeof SORT_KEYS)[number];
    type Sort = SortKey | `${SortKey}-desc`;
    const SORTS = new Set<string>(
        SORT_KEYS.flatMap((key) => [key, `${key}-desc`]),
    );
    const SORT_LABELS: Record<SortKey, string> = {
        id: "catalog #",
        title: "lab",
        difficulty: "difficulty",
        time: "time",
    };
    const DEFAULT_SORT: Sort = "id";

    const filters = {
        difficulty: "all",
        exam: "all",
        query: "",
    };
    let sort: Sort = DEFAULT_SORT;
    let visible: LabRow[] = rows;
    let selectedRow: HTMLElement | null = null;

    const examLabels = new Map<string, string>();
    for (const option of examSelect.options) {
        if (option.value !== "all") {
            examLabels.set(option.value, option.textContent ?? "");
        }
    }

    function sortParts(value: Sort): { key: SortKey; desc: boolean } {
        const desc = value.endsWith("-desc");
        return { key: (desc ? value.slice(0, -5) : value) as SortKey, desc };
    }

    function compare(a: LabRow, b: LabRow): number {
        const { key, desc } = sortParts(sort);
        let result = 0;
        if (key === "title") result = a.title.localeCompare(b.title);
        else if (key === "difficulty")
            result = DIFFICULTY_RANK[a.difficulty] - DIFFICULTY_RANK[b.difficulty];
        else if (key === "time") result = a.minutes - b.minutes;
        result = result || a.number - b.number;
        return desc ? -result : result;
    }

    function highlight(el: HTMLElement, text: string, tokens: string[]) {
        const ranges = tokens.length > 0 ? matchRanges(text, tokens) : [];
        if (ranges.length === 0) {
            el.textContent = text;
            return;
        }
        const fragment = document.createDocumentFragment();
        let cursor = 0;
        for (const range of ranges) {
            if (range.start > cursor) {
                fragment.append(text.slice(cursor, range.start));
            }
            const mark = document.createElement("mark");
            mark.textContent = text.slice(range.start, range.end);
            fragment.append(mark);
            cursor = range.end;
        }
        if (cursor < text.length) fragment.append(text.slice(cursor));
        el.replaceChildren(fragment);
    }

    function matches(row: LabRow, skip?: "difficulty"): boolean {
        if (
            skip !== "difficulty" &&
            filters.difficulty !== "all" &&
            row.difficulty !== filters.difficulty
        )
            return false;
        if (filters.exam !== "all" && !row.exams.includes(filters.exam))
            return false;
        const tokens = tokenize(filters.query);
        return tokens.every((token) => row.search.includes(token));
    }

    function rowIndex(row: Element | null): number {
        return row ? Array.prototype.indexOf.call(list.children, row) : -1;
    }

    function setDifficulty(difficulty: string) {
        filters.difficulty = difficulty;
        for (const chip of chipRow.querySelectorAll(".chip-f")) {
            const active = chip.getAttribute("data-difficulty") === difficulty;
            chip.classList.toggle("on", active);
            chip.setAttribute("aria-pressed", String(active));
        }
    }

    function actionButton(label: string, onClick: () => void) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "bank-action";
        button.textContent = label;
        button.addEventListener("click", onClick);
        return button;
    }

    function updateCounts() {
        shownEl.textContent = String(visible.length);
        countEl.textContent = String(rows.length);
        for (const chip of chipRow.querySelectorAll<HTMLElement>(".chip-f")) {
            const badge = chip.querySelector(".c");
            const difficulty = chip.getAttribute("data-difficulty");
            if (!badge || !difficulty || difficulty === "all") continue;
            badge.textContent = String(
                rows.filter(
                    (row) =>
                        matches(row, "difficulty") &&
                        row.difficulty === difficulty,
                ).length,
            );
        }
    }

    function hasActiveFacets(): boolean {
        return filters.difficulty !== "all" || filters.exam !== "all";
    }

    function showEmptyState() {
        const wrap = document.createElement("div");
        wrap.className = "bank-empty";
        const message = document.createElement("span");
        message.className = "drill-state";
        const query = filters.query.trim();
        const shortQuery = query.length > 40 ? `${query.slice(0, 40)}…` : query;
        message.textContent = query
            ? `no results for "${shortQuery}"`
            : "no matching labs";
        wrap.append(message);
        if (query) wrap.append(actionButton("clear search", clearSearch));
        if (hasActiveFacets()) {
            wrap.append(actionButton("clear filters", clearFacets));
        }
        list.replaceChildren(wrap);
    }

    let statusTimer = 0;
    function announceCount() {
        window.clearTimeout(statusTimer);
        statusTimer = window.setTimeout(() => {
            statusEl.textContent =
                visible.length === 0
                    ? "no matching labs"
                    : `${visible.length} results`;
        }, 500);
    }

    function refresh() {
        const hadListFocus =
            document.activeElement !== null &&
            list.contains(document.activeElement);
        const previousIndex = rowIndex(selectedRow);
        visible = rows.filter((row) => matches(row)).sort(compare);
        selectedRow = null;
        if (visible.length === 0) {
            showEmptyState();
            if (hadListFocus) searchInput.focus();
        } else {
            const tokens = tokenize(filters.query);
            for (const row of visible) {
                highlight(row.titleEl, row.titleText, tokens);
                highlight(row.codeEl, row.codeText, tokens);
            }
            list.replaceChildren(...visible.map((row) => row.el));
            for (const row of visible) row.el.tabIndex = -1;
            if (hadListFocus) {
                select(Math.max(previousIndex, 0));
            } else {
                visible[0].el.tabIndex = 0;
            }
        }
        updateCounts();
        announceCount();
    }

    function select(index: number) {
        if (visible.length === 0) return;
        const clamped = Math.min(Math.max(index, 0), visible.length - 1);
        if (selectedRow) selectedRow.tabIndex = -1;
        visible[0].el.tabIndex = -1;
        selectedRow = visible[clamped].el;
        selectedRow.tabIndex = 0;
        selectedRow.focus({ preventScroll: true });
        selectedRow.scrollIntoView({ block: "nearest" });
    }

    function pickRandom() {
        if (visible.length === 0) return;
        const row = visible[Math.floor(Math.random() * visible.length)];
        window.location.href = row.el.href;
    }

    function renderSortHeaders() {
        const { key, desc } = sortParts(sort);
        for (const button of sortButtons) {
            const active = button.dataset.labsSort === key;
            const arrow = button.querySelector("[data-labs-arrow]")!;
            const note = button.querySelector("[data-labs-note]")!;
            if (active) {
                button.dataset.dir = desc ? "desc" : "asc";
                arrow.textContent = desc ? "▼" : "▲";
                note.textContent = desc
                    ? ", sorted descending"
                    : ", sorted ascending";
            } else {
                delete button.dataset.dir;
                arrow.textContent = "↕";
                note.textContent = "";
            }
        }
    }

    function announceSort() {
        const { key, desc } = sortParts(sort);
        window.clearTimeout(statusTimer);
        statusEl.textContent = `sorted by ${SORT_LABELS[key]}, ${desc ? "descending" : "ascending"}`;
    }

    function setSort(key: SortKey) {
        const current = sortParts(sort);
        sort = current.key === key && !current.desc ? `${key}-desc` : key;
        renderSortHeaders();
        syncUrl(true);
        refresh();
        announceSort();
    }

    for (const button of sortButtons) {
        button.addEventListener("click", () => {
            setSort(button.dataset.labsSort as SortKey);
        });
    }

    chipRow.addEventListener("click", (event) => {
        const chip = (event.target as HTMLElement).closest<HTMLElement>(".chip-f");
        if (!chip) return;
        setDifficulty(chip.getAttribute("data-difficulty") ?? "all");
        syncUrl(true);
        refresh();
    });

    examSelect.addEventListener("change", () => {
        filters.exam = examSelect.value;
        syncUrl(true);
        refresh();
    });

    let searchFrame = 0;
    searchInput.addEventListener("input", () => {
        filters.query = searchInput.value;
        syncClearButton();
        syncUrlDebounced();
        cancelAnimationFrame(searchFrame);
        searchFrame = requestAnimationFrame(refresh);
    });

    function contextParams(): URLSearchParams {
        const params = new URLSearchParams();
        if (filters.difficulty !== "all")
            params.set("difficulty", filters.difficulty);
        if (filters.exam !== "all") params.set("exam", filters.exam);
        if (sort !== DEFAULT_SORT) params.set("sort", sort);
        const query = filters.query.trim();
        if (query) params.set("q", query);
        return params;
    }

    function syncUrl(push: boolean) {
        const encoded = contextParams().toString();
        const url = encoded
            ? `${location.pathname}?${encoded}`
            : location.pathname;
        if (url === location.pathname + location.search) return;
        if (push) history.pushState(null, "", url);
        else history.replaceState(null, "", url);
    }

    let urlTimer = 0;
    function syncUrlDebounced() {
        window.clearTimeout(urlTimer);
        urlTimer = window.setTimeout(() => syncUrl(false), 300);
    }

    function applyUrlState() {
        const params = new URLSearchParams(location.search);
        const difficulty = params.get("difficulty") ?? "all";
        setDifficulty(DIFFICULTIES.has(difficulty) ? difficulty : "all");
        const exam = params.get("exam") ?? "all";
        filters.exam = examLabels.has(exam) ? exam : "all";
        examSelect.value = filters.exam;
        const sortParam = params.get("sort") ?? DEFAULT_SORT;
        sort = SORTS.has(sortParam) ? (sortParam as Sort) : DEFAULT_SORT;
        renderSortHeaders();
        filters.query = params.get("q") ?? "";
        searchInput.value = filters.query;
        syncClearButton();
        refresh();
    }

    function syncClearButton() {
        const hasText = searchInput.value.length > 0;
        clearButton.hidden = !hasText;
        slashHint.hidden = hasText;
    }

    function clearSearch() {
        searchInput.value = "";
        filters.query = "";
        syncClearButton();
        searchInput.focus();
        syncUrl(false);
        refresh();
    }

    function clearFacets() {
        filters.exam = "all";
        examSelect.value = "all";
        setDifficulty("all");
        searchInput.focus();
        syncUrl(true);
        refresh();
    }

    randomButton.addEventListener("click", pickRandom);
    clearButton.addEventListener("click", clearSearch);

    window.addEventListener("popstate", applyUrlState);
    window.addEventListener("pageshow", (event) => {
        if (event.persisted) applyUrlState();
    });

    list.addEventListener("keydown", (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        if (event.key === "/") {
            event.preventDefault();
            searchInput.focus();
            return;
        }
        const target =
            event.target instanceof HTMLElement ? event.target : null;
        const focusedRow = target?.closest(".lrow");
        if (!focusedRow) return;
        const index = rowIndex(focusedRow);
        if (event.key === "ArrowDown") {
            event.preventDefault();
            select(index + 1);
        } else if (event.key === "ArrowUp") {
            event.preventDefault();
            if (index <= 0) searchInput.focus();
            else select(index - 1);
        } else if (event.key === "Home") {
            event.preventDefault();
            select(0);
        } else if (event.key === "End") {
            event.preventDefault();
            select(visible.length - 1);
        } else if (event.key.toLowerCase() === "r") {
            pickRandom();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.isComposing || event.keyCode === 229) return;
        const target =
            event.target instanceof HTMLElement ? event.target : null;
        if (target && list.contains(target)) return;
        if (target === searchInput) {
            if (event.key === "Escape") {
                event.preventDefault();
                if (searchInput.value) clearSearch();
                else searchInput.blur();
            } else if (event.key === "ArrowDown") {
                event.preventDefault();
                select(Math.max(rowIndex(selectedRow), 0));
            }
            return;
        }
        if (
            target?.matches("input, textarea, select, [contenteditable='true']")
        ) {
            return;
        }
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        if (event.key === "/") {
            event.preventDefault();
            searchInput.focus();
        }
    });

    applyUrlState();
</script>
