---
import type {
    SelectorCategory,
    TrackSelector,
} from "../../data/track-selectors";
import { loadCatalogDrills } from "../../build/db";

interface Props {
    track: TrackSelector;
    category: SelectorCategory;
}

const { track, category } = Astro.props;

const drills = await loadCatalogDrills(track.slug, category.slug, null);
---

<div class="top-bar">
    <div class="breadcrumb">
        netlabs <span class="chev">/</span> tracks <span class="chev">/</span>
        <b>{track.statusLabel}</b>
        <span class="chev">/</span>
        <b>{category.slug}</b>
    </div>
</div>

<div class="editor-body inner-page">
    <section class="inner-hero">
        <div>
            <h1>
                {category.name}
                <span>{category.path}</span>
            </h1>
            <p>{category.description}</p>
        </div>
    </section>

    <div class="drill-toolbar">
        <h2>drills in this category</h2>
        <span class="count"><b>{drills.length}</b> drills</span>
    </div>

    <div class="drills">
        {
            drills.length === 0 ? (
                <span class="drill-state">no drills yet</span>
            ) : (
                drills.map((drill) => (
                    <a class="drill-row" href={drill.href}>
                        <span class="body">
                            <span class="name">{drill.name}</span>
                            <span class="desc">{drill.description}</span>
                        </span>
                        <span class="meta">
                            <span>
                                <span class="lab">items</span>
                                <b>{drill.item_count}</b>
                            </span>
                        </span>
                        <span class="cta">
                            <span class="start">start drill →</span>
                        </span>
                    </a>
                ))
            )
        }
    </div>
</div>
