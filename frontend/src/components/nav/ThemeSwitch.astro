<div class="theme-switch" role="group" aria-label="Theme">
    <button type="button" data-choice="light" aria-label="Light theme">Light</button>
    <button type="button" data-choice="dark" aria-label="Dark theme">Dark</button>
    <button type="button" data-choice="system" aria-label="Follow system theme">System</button>
</div>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(
        ".theme-switch button",
    );
    const media = matchMedia("(prefers-color-scheme: light)");

    const storedChoice = () => {
        try {
            const value = localStorage.getItem("theme");
            return value === "light" || value === "dark" ? value : "system";
        } catch {
            return "system";
        }
    };

    const apply = () => {
        const choice = storedChoice();
        const theme =
            choice === "system" ? (media.matches ? "light" : "dark") : choice;
        document.documentElement.dataset.theme = theme;
        for (const button of buttons) {
            const active = button.dataset.choice === choice;
            button.classList.toggle("active", active);
            button.setAttribute("aria-pressed", String(active));
        }
    };

    for (const button of buttons) {
        button.addEventListener("click", () => {
            try {
                if (button.dataset.choice === "system") {
                    localStorage.removeItem("theme");
                } else {
                    localStorage.setItem("theme", button.dataset.choice ?? "");
                }
            } catch {}
            apply();
        });
    }

    media.addEventListener("change", () => {
        if (storedChoice() === "system") apply();
    });

    apply();
</script>
