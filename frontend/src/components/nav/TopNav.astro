---
import BrandLogo from "./BrandLogo.astro";
import GitHubStarButton from "./GitHubStarButton.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
---

<div class="nav-row">
    <BrandLogo />

    <div class="nav-items" aria-label="Sections">
        <a href="/ccna">CCNA</a>
        <a href="/ccnp-encor">CCNP</a>
        <a href="/ccna/bank">Bank</a>
        <a href="/labs">Labs <small>soon</small></a>
    </div>

    <div class="nav-cta">
        <ThemeSwitch />
        <GitHubStarButton />
        <!-- <a class="btn primary">View</a> -->
    </div>
</div>

<script>
    const nav = document.querySelector("nav.top");
    const pane = document.querySelector(".editor-body");

    const update = () => {
        const y = Math.max(window.scrollY, pane ? pane.scrollTop : 0);
        nav?.classList.toggle("nav-collapsed", y > 24);
    };

    window.addEventListener("scroll", update, { passive: true });
    pane?.addEventListener("scroll", update, { passive: true });
    update();
</script>
