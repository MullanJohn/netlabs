---
import type {
    SelectorCategory,
    TrackSelector,
} from "../../data/track-selectors";
import type { CatalogDrill } from "../../data/catalog-types";

interface Props {
    category: SelectorCategory;
    track: TrackSelector;
    items: CatalogDrill[];
}

const { category, track, items } = Astro.props;
const href = `/${track.slug}/${category.slug}`;
const shortcut = category.label.slice(1);

const moreLabels = {
    "domain-drills": "view all domains →",
    "section-drills": "view all sections →",
    "topic-drills": "view all topics →",
    "skill-sets": "view all skill-sets →",
    "mixed-reviews": "view all reviews →",
    exams: "view all exams →",
} as const;

const moreLabel = moreLabels[category.slug];
---

<article
    class="selector-card"
    id={`cat-${shortcut}`}
    data-category-shortcut={shortcut}
>
    <div class="selector-card-head">
        <div>
            <h3>
                {category.name}
                <span>{category.path}</span>
            </h3>
            <p>{category.description}</p>
        </div>
        <div class="selector-card-meta">
            <span class="selector-card-keys"
                ><span class="kbd">{shortcut}</span> jump</span
            >
        </div>
    </div>

    <div class="selector-preview">
        {
            items.length === 0 ? (
                <span class="selector-preview-state">no drills yet</span>
            ) : (
                items.map((item, index) => (
                    <a class="selector-preview-row" href={item.href}>
                        <span class="selector-preview-id">
                            {String(index + 1).padStart(2, "0")}
                        </span>
                        <span class="selector-preview-name">{item.name}</span>
                        <b>{item.item_count} items</b>
                    </a>
                ))
            )
        }
    </div>

    <div class="selector-card-foot">
        <a class="more" href={href}>{moreLabel}</a>
        {
            category.slug === "exams" && (
                <span class="tagline">
                    scored <b>0-1000</b>
                </span>
            )
        }
    </div>
</article>
