---
const cards = [
    {
        label: "200-301 · 350-401",
        name: "Cisco",
        meta: "CCNA · CCNP ENCOR",
        body: "Blueprint-aligned question banks for the Cisco certification tracks, mapped to the official exam domains.",
        upcoming: false,
    },
    {
        label: "EOS",
        name: "Arista",
        meta: "in progress",
        body: "ACE certification tracks for Arista EOS, structured the same way as the Cisco banks.",
        upcoming: true,
    },
    {
        label: "Containerlab",
        name: "Labs",
        meta: "in progress",
        body: "Hands-on network labs covering route tables, subnetting, configuration, and topology reasoning.",
        upcoming: true,
    },
] as const;
---

<div class="tracks">
    {
        cards.map((card) => (
            <article class={`track ${card.upcoming ? "upcoming" : ""}`}>
                <div class="label">{card.label}</div>
                <h3>{card.name}</h3>
                <div class="count">{card.meta}</div>
                <p>{card.body}</p>
            </article>
        ))
    }
</div>
