import TopNav from "../../components/nav/TopNav.astro";
import StatusBar from "../../components/shell/StatusBar.astro";
import QuizAttemptPage from "../../quiz/QuizAttemptPage";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Quiz attempt for netlabs." />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="preload"
            href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>netlabs · quiz</title>
    </head>
    <body>
        <QuizShell>
            <TopNav slot="nav" />

            <QuizAttemptPage client:only="react">
                <div slot="fallback" class="main">
                    <aside class="pane sidebar"></aside>
                    <section class="pane editor"></section>
                </div>
            </QuizAttemptPage>

            <StatusBar slot="status" branch="quiz" />
        </QuizShell>
    </body>
</html>
