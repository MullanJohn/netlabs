---
import AppShell from "../layouts/AppShell.astro";
import LandingContent from "../components/home/LandingContent.astro";
import TopNav from "../components/nav/TopNav.astro";
import StatusBar from "../components/shell/StatusBar.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="netlabs is a focused CCNA and CCNP practice bank for network exam preparation." />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="preload"
            href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>netlabs</title>
    </head>
    <body>
        <AppShell>
            <TopNav slot="nav" />

            <LandingContent />

            <StatusBar slot="status" />
        </AppShell>
    </body>
</html>
