---
import "../styles/global.css";

const hasSidebar = Astro.slots.has("sidebar");
---

<div class="win">
    <nav class="top" aria-label="Primary">
        <slot name="nav" />
    </nav>

    <div class:list={["main", { "no-sidebar": !hasSidebar }]}>
        {
            hasSidebar && (
                <aside class="pane sidebar">
                    <slot name="sidebar" />
                </aside>
            )
        }

        <section class="pane editor">
            <slot />
        </section>
    </div>

    <footer class="status">
        <slot name="status" />
    </footer>
</div>
